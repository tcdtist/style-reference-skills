{
  "name": "style-reference-skills",
  "version": "1.1.0",
  "description": "Curated DESIGN.md style references from 1,300+ real-world brands for AI agents",
  "private": true,
  "scripts": {
    "test": "npx tsx scripts/test-api-local.ts",
    "validate": "npx tsx scripts/validate-design-md.ts",
    "type-check": "tsc --noEmit",
    "build:index": "npx tsx scripts/build-index.ts",
    "build:mcp": "pnpm --filter style-reference-mcp run build",
    "cli": "python3 scripts/style_ref.py"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "ai-agent",
    "style-reference",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "author": "tcdtist",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
